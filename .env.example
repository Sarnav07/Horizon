# HSKChain - keep all values server-side when live services are added.
VITE_HSKCHAIN_TESTNET_RPC=https://testnet.hsk.xyz
VITE_HSKCHAIN_TESTNET_CHAIN_ID=133
VITE_HSKCHAIN_MAINNET_CHAIN_ID=177
VITE_HSKSWAP_SUBGRAPH=https://graphnode.hashkeychain.net/subgraphs/name/hskswap
VITE_HORIZON_API_URL=http://127.0.0.1:8787

# Do not add private keys or exchange API secrets to VITE_ variables.
# DATABASE_URL=
# REDIS_URL=
# OPENAI_API_KEY=

# Server-only development configuration. The API defaults to loopback and cannot submit trades.
HORIZON_APP_ORIGIN=http://localhost:5173
HORIZON_API_HOST=127.0.0.1
HORIZON_API_PORT=8787
HORIZON_DB_PATH=./data/horizon.sqlite
HORIZON_MAINNET_RPC=https://mainnet.hsk.xyz
HORIZON_HSKSWAP_SUBGRAPH=https://graphnode.hashkeychain.net/subgraphs/name/hskswap
HORIZON_COLLECT_INTERVAL_MS=15000
HORIZON_PAPER_CONFIG=./server/paper-config.local.json
HORIZON_FORK_RPC=http://127.0.0.1:8545
HORIZON_FORK_REPLAY_CONFIG=./data/fork-replay.local.json
HORIZON_TESTNET_RPC=https://testnet.hsk.xyz
HORIZON_TESTNET_RECEIPTS=./data/testnet-receipts.local.json
