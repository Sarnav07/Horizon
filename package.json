{
  "name": "horizon-trading-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src/lib",
    "test:watch": "vitest src/lib",
    "test:local": "bun test src/lib",
    "contracts:test": "forge test --root contracts",
    "test:backend": "node --test server/*.test.mjs",
    "market:collect": "node server/collect.mjs",
    "market:paper": "node server/paper-main.mjs",
    "paper:fill": "node server/paper-fill-main.mjs",
    "fork:replay": "node server/fork-replay.mjs",
    "testnet:verify": "node server/testnet-verify.mjs",
    "api": "node server/api-main.mjs",
    "diagnostics:local": "node server/local-diagnostics.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
